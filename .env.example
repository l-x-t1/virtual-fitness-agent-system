JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# 数据库：开发用 SQLite（开箱即用）；团队/生产用 PostgreSQL
# 切换 PostgreSQL 步骤见 tools/migrate_sqlite_to_postgres.py 顶部注释
#DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/virtual_fitness_agent_system
DATABASE_URL=sqlite:///fitness.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis 缓存（可选，连不上自动降级不报错）
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_DEFAULT_TTL=300
CACHE_LOCK_TTL=8

# LLM provider: deepseek or dashscope
LLM_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# Embedding/RAG: local Chinese semantic embeddings + persistent Chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_ALLOW_FALLBACK=true
EMBEDDING_ALLOW_DOWNLOAD=false
CHROMA_PERSIST_DIRECTORY=data/chroma
EXERCISE_CHROMA_COLLECTION=fitness-exercises

# 人员 C 独立 AI 教练配置（支持按请求切换 provider/model）
AI_SESSION_TTL_HOURS=720
# 可选；默认保存到 app/ai/data/ai_sessions.db
AI_SESSION_DB=

# 可观测性（可选；关闭、缺少密钥或 SDK 不可用时自动使用脱敏本地日志）
OBSERVABILITY_ENABLED=false
OBSERVABILITY_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=virtual-fitness-agent-system

# Neo4j 图谱：本地（开发） / AuraDB 云端（团队共享，需 VPN），二选一启用
# 本地：
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=fitness123
NEO4J_DATABASE=neo4j
# 云端 AuraDB（从 https://console.neo4j.io 获取）：
#NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
#NEO4J_USERNAME=xxxxxxxx
#NEO4J_PASSWORD=xxxxxxxx
#NEO4J_DATABASE=neo4j
