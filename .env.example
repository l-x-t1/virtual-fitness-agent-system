JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/virtual_fitness_agent_system
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300
CACHE_LOCK_TTL=8

# LLM provider: deepseek or dashscope
LLM_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# Neo4j AuraDB 云端图谱（从 https://console.neo4j.io 获取）
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=xxxxxxxx
NEO4J_PASSWORD=xxxxxxxx
NEO4J_DATABASE=neo4j
